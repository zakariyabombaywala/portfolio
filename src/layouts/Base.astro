---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { person, seo } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = seo.title, description = seo.description, noindex = false } = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(seo.ogImage, site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  description: seo.description,
  email: `mailto:${person.email}`,
  url: site.href,
  image: ogImage,
  sameAs: [person.upwork],
  worksFor: { '@type': 'Organization', name: person.company },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Surat',
    addressRegion: 'Gujarat',
    addressCountry: 'IN',
  },
  knowsLanguage: person.languages,
  knowsAbout: ['React', 'Astro', 'WordPress', 'JavaScript', 'CSS', 'Figma to web', 'Core Web Vitals'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Apply a saved theme before first paint to avoid a flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // Scroll reveals: hide content only if it can be revealed again.
      // If the reveal script never starts, show everything after 3s.
      if ('IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('can-reveal');
        setTimeout(() => {
          if (!window.__revealReady) document.documentElement.classList.remove('can-reveal');
        }, 3000);
      }
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="theme-color" content="#EDEFF2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1F24" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />

    <Font cssVariable="--font-sans" preload />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script>
      import 'lenis/dist/lenis.css';
      import Lenis from 'lenis';
      import { gsap, ScrollTrigger, finePointer, prefersMotion } from '../scripts/motion';

      (window as Window & { __revealReady?: boolean }).__revealReady = true;

      const items = gsap.utils.toArray<HTMLElement>('[data-animate]');
      const reveal = (batch: HTMLElement[]) => {
        batch.forEach((el) => el.classList.add('is-in'));
        gsap.to(batch, { opacity: 1, y: 0, duration: 1.1, ease: 'expo.out', stagger: 0.1, overwrite: true });
      };

      if (prefersMotion()) {
        // Smooth scrolling, kept in sync with ScrollTrigger. In-page links still work.
        const lenis = new Lenis({ autoRaf: false, lerp: 0.11, anchors: { offset: -88 } });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);

        // Content rises in, a batch at a time, as it scrolls into view.
        // Opacity only (not visibility), so keyboard users can still reach everything.
        gsap.set(items, { opacity: 0, y: 56 });
        ScrollTrigger.batch(items, { start: 'top 90%', once: true, onEnter: (batch) => reveal(batch as HTMLElement[]) });
        document.addEventListener('focusin', (event) => {
          const hidden = (event.target as Element).closest<HTMLElement>('[data-animate]:not(.is-in)');
          if (hidden) reveal([hidden]);
        });

        if (finePointer()) {
          // Button glow follows the cursor (see .btn::before in global.css).
          document.addEventListener('pointermove', (event) => {
            const button = (event.target as Element).closest<HTMLElement>('.btn');
            if (!button) return;
            const r = button.getBoundingClientRect();
            button.style.setProperty('--bx', `${event.clientX - r.left}px`);
            button.style.setProperty('--by', `${event.clientY - r.top}px`);
          });

          // Magnetic buttons: drift toward the pointer, spring back on leave.
          gsap.utils.toArray<HTMLElement>('[data-magnetic]').forEach((button) => {
            const xTo = gsap.quickTo(button, 'x', { duration: 0.5, ease: 'power3.out' });
            const yTo = gsap.quickTo(button, 'y', { duration: 0.5, ease: 'power3.out' });
            button.addEventListener('pointermove', (event) => {
              const r = button.getBoundingClientRect();
              xTo((event.clientX - (r.left + r.width / 2)) * 0.3);
              yTo((event.clientY - (r.top + r.height / 2)) * 0.4);
            });
            button.addEventListener('pointerleave', () => {
              gsap.to(button, { x: 0, y: 0, duration: 0.9, ease: 'elastic.out(1, 0.4)', overwrite: true });
            });
          });
        }
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
