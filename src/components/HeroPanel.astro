---
/**
 * Figma-style properties panel for the hero headline. "Design" shows the
 * headline's live specs; "Code" shows the same specs as CSS.
 */
import { hero } from '../data/site';

// Server-rendered defaults; the script replaces them with live measurements.
const defaultCss = `.heading {
  font-family: "Schibsted Grotesk";
  font-weight: 800;
  font-size: 96px;
  line-height: 91px;
  letter-spacing: -0.04em;
  color: #16181D;
}`;
---

<aside class="panel enter" style="--enter-delay: 0.55s" aria-label={hero.panel.label} data-hero-panel>
  <div class="tabs" role="tablist" aria-label={hero.panel.label}>
    <button
      class="tab"
      type="button"
      role="tab"
      id="hp-tab-design"
      aria-selected="true"
      aria-controls="hp-design"
      data-tab>{hero.panel.designTab}</button
    >
    <button
      class="tab"
      type="button"
      role="tab"
      id="hp-tab-code"
      aria-selected="false"
      aria-controls="hp-code"
      tabindex="-1"
      data-tab>{hero.panel.codeTab}</button
    >
  </div>

  <div class="body" role="tabpanel" id="hp-design" aria-labelledby="hp-tab-design" tabindex="0">
    <div class="group">
      <p class="group-title">Layer</p>
      <p class="layer">
        <span class="layer-icon" aria-hidden="true">T</span>
        {hero.specLayer}
      </p>
    </div>

    <div class="group">
      <p class="group-title">Frame</p>
      <dl class="fields">
        <div class="field"><dt>W</dt><dd data-spec="width">680</dd></div>
        <div class="field"><dt>H</dt><dd data-spec="height">364</dd></div>
      </dl>
    </div>

    <div class="group">
      <p class="group-title">Text</p>
      <p class="field field--wide">Schibsted Grotesk</p>
      <dl class="fields">
        <div class="field"><dt>Weight</dt><dd data-spec="weight">ExtraBold</dd></div>
        <div class="field"><dt>Size</dt><dd data-spec="size">96</dd></div>
        <div class="field"><dt>Line</dt><dd data-spec="line">91</dd></div>
        <div class="field"><dt>Letter</dt><dd data-spec="letter">-4%</dd></div>
      </dl>
    </div>

    <div class="group">
      <p class="group-title">Fill</p>
      <p class="field field--wide">
        <span class="swatch" aria-hidden="true"></span>
        <span class="hex" data-spec="hex">16181D</span>
        <span class="opacity">100%</span>
      </p>
    </div>
  </div>

  <div class="body" role="tabpanel" id="hp-code" aria-labelledby="hp-tab-code" tabindex="0" hidden>
    <pre class="code"><code data-spec="code">{defaultCss}</code></pre>
    <button
      class="btn btn--secondary copy-css"
      type="button"
      data-copy-css
      data-copied-label={hero.panel.copied}
      hidden>{hero.panel.copyCss}</button
    >
    <span class="sr-only" role="status" data-copy-css-status></span>
  </div>

  <p class="status">
    <span class="dot" aria-hidden="true"></span>
    {hero.status}
  </p>
</aside>

<script>
  import { subscribe, weightNames } from '../scripts/headline-specs';

  const panel = document.querySelector<HTMLElement>('[data-hero-panel]');

  if (panel) {
    const set = (key: string, value: string) =>
      panel.querySelectorAll<HTMLElement>(`[data-spec="${key}"]`).forEach((el) => (el.textContent = value));

    const code = panel.querySelector<HTMLElement>('[data-spec="code"]');

    // Builds the CSS view as DOM nodes so properties and values can be coloured.
    const renderCode = (rules: [string, string][]) => {
      if (!code) return;
      const line = (text: string, className?: string) => {
        const span = document.createElement('span');
        if (className) span.className = className;
        span.textContent = text;
        return span;
      };
      const nodes: (Node | string)[] = [line('.heading', 'tok-sel'), ' {\n'];
      for (const [prop, value] of rules) {
        nodes.push('  ', line(prop, 'tok-prop'), ': ', line(value, 'tok-val'), ';\n');
      }
      nodes.push('}');
      code.replaceChildren(...nodes);
    };

    subscribe((specs) => {
      const letter = Math.round(specs.letterSpacing * 1000) / 10;
      set('width', String(specs.width));
      set('height', String(specs.height));
      set('weight', weightNames[specs.fontWeight] ?? specs.fontWeight);
      set('size', String(specs.fontSize));
      set('line', String(specs.lineHeight));
      set('letter', `${letter}%`);
      set('hex', specs.color);
      renderCode([
        ['width', `${specs.width}px`],
        ['font-family', '"Schibsted Grotesk"'],
        ['font-weight', specs.fontWeight],
        ['font-size', `${specs.fontSize}px`],
        ['line-height', `${specs.lineHeight}px`],
        ['letter-spacing', `${Math.round(specs.letterSpacing * 1000) / 1000}em`],
        ['color', `#${specs.color}`],
      ]);
    });

    // Tabs: click, or arrow keys / Home / End within the tab list.
    const tabs = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-tab]'));

    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const selected = t === tab;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
        const target = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (target) target.hidden = !selected;
      }
      if (focus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next: Record<string, number> = {
          ArrowRight: index === last ? 0 : index + 1,
          ArrowLeft: index === 0 ? last : index - 1,
          Home: 0,
          End: last,
        };
        if (!(event.key in next)) return;
        event.preventDefault();
        select(tabs[next[event.key]], true);
      });
    });

    // Copy CSS
    const copy = panel.querySelector<HTMLButtonElement>('[data-copy-css]');
    const copyStatus = panel.querySelector<HTMLElement>('[data-copy-css-status]');

    if (copy && code && navigator.clipboard) {
      const original = copy.textContent ?? '';
      let timer: number | undefined;
      copy.hidden = false;
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          copy.textContent = copy.dataset.copiedLabel ?? 'Copied';
          if (copyStatus) copyStatus.textContent = 'CSS copied to clipboard';
        } catch {
          return;
        }
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          copy.textContent = original;
          if (copyStatus) copyStatus.textContent = '';
        }, 2000);
      });
    }
  }
</script>

<style>
  .panel {
    align-self: start;
    width: 100%;
    max-width: 26rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 12px 32px -12px rgb(0 0 0 / 0.12);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem 0.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .tab {
    position: relative;
    padding: 0.5rem 0.625rem 0.625rem;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }

  .tab:hover,
  .tab[aria-selected='true'] {
    color: var(--ink);
  }

  .tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    left: 0.625rem;
    right: 0.625rem;
    bottom: -1px;
    height: 2px;
    background: var(--ink);
  }

  .body {
    padding: 0.25rem 1rem 1rem;
  }

  .body[hidden] {
    display: none;
  }

  .body:focus-visible {
    outline-offset: -2px;
  }

  .group {
    display: grid;
    gap: 0.5rem;
    padding-block: 0.875rem;
  }

  .group + .group {
    border-top: 1px solid var(--line);
  }

  .group-title {
    font-weight: 600;
  }

  .layer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .layer-icon {
    display: inline-grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border: 1px solid var(--blue);
    border-radius: 2px;
    color: var(--blue);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.375rem 0.5rem;
    border-radius: 4px;
    background: var(--canvas);
  }

  .field dt {
    color: var(--muted);
  }

  .field dd {
    margin: 0;
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    white-space: nowrap;
  }

  .swatch {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 2px;
    background: var(--ink);
    box-shadow: inset 0 0 0 1px rgb(127 127 127 / 0.3);
  }

  .hex {
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .opacity {
    margin-left: auto;
    color: var(--muted);
  }

  .code {
    margin: 0.875rem 0 0.75rem;
    padding: 0.875rem 1rem;
    overflow-x: auto;
    border-radius: 4px;
    background: var(--canvas);
    font-family: ui-monospace, 'Cascadia Code', 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.75rem;
    line-height: 1.7;
    tab-size: 2;
  }

  .code :global(.tok-sel) {
    color: var(--ink);
    font-weight: 600;
  }

  .code :global(.tok-prop) {
    color: var(--muted);
  }

  .code :global(.tok-val) {
    color: var(--ink);
  }

  .copy-css {
    width: 100%;
    min-height: 2.25rem;
    font-size: 0.8125rem;
  }

  .copy-css[hidden] {
    display: none;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #14ae5c;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: #14ae5c;
      animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) 3s infinite;
    }
  }

  @keyframes ping {
    0% { transform: scale(1); opacity: 0.6; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }

  /* Hover: fields get an outline, like inputs in Figma's properties panel. */
  .field {
    transition: box-shadow 0.2s ease;
  }

  .field:hover {
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
