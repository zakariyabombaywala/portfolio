---
import { contact, person } from '../data/site';
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title" data-split>{contact.title}</h2>
    <p class="body" data-animate>{contact.body}</p>

    <a class="email" href={`mailto:${person.email}`} data-animate>{person.email}</a>

    <div class="actions" data-animate>
      <button
        class="btn btn--secondary copy"
        type="button"
        data-copy={person.email}
        data-copied-label={contact.copiedLabel}
        hidden
      >
        <span data-copy-label>{contact.copyLabel}</span>
      </button>
      <a class="btn btn--primary" href={person.upwork} target="_blank" rel="noopener" data-magnetic>
        {contact.upworkLabel}<span class="sr-only"> (opens in a new tab)</span>
      </a>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
    </div>

    <p class="where">{person.location}</p>
  </div>
</section>

<script>
  import { gsap, SplitText, finePointer, prefersMotion } from '../scripts/motion';

  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = document.querySelector<HTMLElement>('[data-copy-label]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  const fallbackCopy = (text: string) => {
    const field = document.createElement('textarea');
    field.value = text;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.opacity = '0';
    document.body.append(field);
    field.select();
    const ok = document.execCommand('copy');
    field.remove();
    return ok;
  };

  if (button && label) {
    const original = label.textContent ?? '';
    let timer: number | undefined;
    button.hidden = false;

    button.addEventListener('click', async () => {
      const text = button.dataset.copy ?? '';
      let ok = false;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        ok = fallbackCopy(text);
      }

      label.textContent = ok ? (button.dataset.copiedLabel ?? 'Copied') : 'Press Ctrl+C to copy';
      button.classList.toggle('is-copied', ok);
      if (status) status.textContent = ok ? 'Email address copied to clipboard' : '';

      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = original;
        button.classList.remove('is-copied');
        if (status) status.textContent = '';
      }, 2400);
    });
  }

  // Hovering the email sends a ripple through its letters.
  const email = document.querySelector<HTMLElement>('.email');
  if (email && prefersMotion() && finePointer() && window.matchMedia('(min-width: 48rem)').matches) {
    document.fonts.ready.then(() => {
      const { chars } = SplitText.create(email, { type: 'chars' });
      let wave: gsap.core.Timeline | undefined;
      email.addEventListener('pointerenter', () => {
        if (wave?.isActive()) return;
        wave = gsap
          .timeline()
          .to(chars, { yPercent: -24, duration: 0.2, ease: 'power2.out', stagger: 0.016 })
          .to(chars, { yPercent: 0, duration: 0.6, ease: 'elastic.out(1, 0.4)', stagger: 0.016 }, 0.2);
      });
    });
  }
</script>

<style>
  .contact {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }

  h2 {
    /* Contains the split-word masks' negative margins. */
    display: flow-root;
    max-width: 18ch;
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  .body {
    max-width: 36rem;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .email {
    display: inline-block;
    max-width: 100%;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-size: clamp(1.375rem, 0.4rem + 4.6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
    padding-bottom: 0.12em;
    text-decoration: none;
    /* Underline drawn as backgrounds (letters get split for the hover ripple):
       a grey rule, with a blue one that sweeps across on hover. */
    background:
      linear-gradient(var(--blue), var(--blue)) no-repeat left bottom / 0% 3px,
      linear-gradient(var(--line), var(--line)) no-repeat left bottom / 100% 2px;
    transition: background-size 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .email:hover,
  .email:focus-visible {
    background-size:
      100% 3px,
      100% 2px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .copy {
    min-width: 8.5rem;
  }

  .copy[hidden] {
    display: none;
  }

  .copy.is-copied {
    border-color: var(--blue);
    box-shadow: inset 0 0 0 1px var(--blue);
  }

  .where {
    margin-top: 2.5rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
