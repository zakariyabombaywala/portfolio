---
import SectionHeading from './SectionHeading.astro';
import { work, type ProjectCategory } from '../data/site';

const categories = Object.entries(work.categories) as [ProjectCategory, string][];
const countFor = (category: ProjectCategory) => work.projects.filter((p) => p.category === category).length;
const hostname = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="container">
    <SectionHeading id="work-title" title={work.title} intro={work.intro} />

    <div class="filters" role="group" aria-label="Filter projects" data-filters hidden>
      <button class="filter" type="button" aria-pressed="true" data-filter="all">
        {work.allLabel}<span class="count">{work.projects.length}</span>
      </button>
      {categories.map(([key, label]) => (
        <button class="filter" type="button" aria-pressed="false" data-filter={key}>
          {label}<span class="count">{countFor(key)}</span>
        </button>
      ))}
    </div>
    <p class="sr-only" role="status" data-filter-status></p>

    <ol class="rows">
      {work.projects.map((project) => (
        <li class="row" data-category={project.category} data-animate>
          <div class="thumb" data-thumb>
            {project.image ? (
              <img
                src={project.image}
                alt={project.imageAlt ?? `Screenshot of ${project.title}`}
                width="720"
                height="1800"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="thumb-empty" aria-hidden="true">
                <span>Screenshot</span>
                <span>16:10</span>
              </span>
            )}
          </div>

          <div class="body">
            <p class="meta">
              {project.type}
              {project.year && `, ${project.year}`}
            </p>

            <h3 class="title">
              {project.url ? (
                <a class="title-link" href={project.url} target="_blank" rel="noopener">
                  {project.title}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                project.title
              )}
              <span class:list={['badge', `badge--${project.category}`]}>{work.categories[project.category]}</span>
            </h3>

            <p class="summary">{project.summary}</p>

            <p class="stack">
              <span class="sr-only">Built with: </span>
              {project.stack.join(', ')}
            </p>

            {project.url ? <p class="domain">{hostname(project.url)}</p> : <p class="domain">Live link coming soon</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>

  <span class="visit" aria-hidden="true" data-visit>{work.visitLabel}</span>
</section>

<script>
  import { gsap, Flip, finePointer, prefersMotion } from '../scripts/motion';

  const group = document.querySelector<HTMLElement>('[data-filters]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.rows > li'));

  // Filters: rows glide into their new places (GSAP Flip) instead of jumping.
  if (group) {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    group.hidden = false;

    const apply = (filter: string) => {
      const state = Flip.getState(rows);
      let shown = 0;

      for (const row of rows) {
        const visible = filter === 'all' || row.dataset.category === filter;
        row.hidden = !visible;
        if (visible) shown++;
      }

      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      }
      if (status) status.textContent = `Showing ${shown} ${shown === 1 ? 'project' : 'projects'}`;

      if (!prefersMotion()) return;
      Flip.from(state, {
        duration: 0.7,
        ease: 'power3.inOut',
        absolute: true,
        onEnter: (entering) => {
          entering.forEach((el) => el.classList.add('is-in'));
          return gsap.fromTo(entering, { opacity: 0, y: 48 }, { opacity: 1, y: 0, duration: 0.7, delay: 0.25, stagger: 0.08, ease: 'expo.out' });
        },
        onLeave: (leaving) => gsap.to(leaving, { opacity: 0, scale: 0.97, duration: 0.3 }),
      });
    };

    buttons.forEach((button) => button.addEventListener('click', () => apply(button.dataset.filter ?? 'all')));
  }

  // Screenshot tilts in 3D toward the pointer while it scrolls through the page (CSS).
  if (prefersMotion() && finePointer()) {
    for (const row of rows) {
      const thumb = row.querySelector<HTMLElement>('[data-thumb]');
      if (!thumb) continue;
      gsap.set(thumb, { transformPerspective: 900 });
      const rotateX = gsap.quickTo(thumb, 'rotationX', { duration: 0.6, ease: 'power3.out' });
      const rotateY = gsap.quickTo(thumb, 'rotationY', { duration: 0.6, ease: 'power3.out' });

      row.addEventListener('pointermove', (event) => {
        const r = thumb.getBoundingClientRect();
        const clamp = gsap.utils.clamp(-1, 1);
        const dx = clamp((event.clientX - (r.left + r.width / 2)) / r.width);
        const dy = clamp((event.clientY - (r.top + r.height / 2)) / r.height);
        rotateY(dx * 9);
        rotateX(-dy * 9);
      });
      row.addEventListener('pointerleave', () => {
        rotateX(0);
        rotateY(0);
      });
    }

    // "Visit site" pill that trails the cursor over rows that link somewhere.
    const visit = document.querySelector<HTMLElement>('[data-visit]');
    if (visit) {
      gsap.set(visit, { xPercent: -50, yPercent: -50, scale: 0, autoAlpha: 0 });
      const xTo = gsap.quickTo(visit, 'x', { duration: 0.45, ease: 'power3.out' });
      const yTo = gsap.quickTo(visit, 'y', { duration: 0.45, ease: 'power3.out' });
      const show = (on: boolean) =>
        gsap.to(visit, { scale: on ? 1 : 0, autoAlpha: on ? 1 : 0, duration: on ? 0.4 : 0.25, ease: on ? 'back.out(2)' : 'power2.in', overwrite: 'auto' });

      for (const row of rows) {
        if (!row.querySelector('.title-link')) continue;
        row.addEventListener('pointerenter', (event) => {
          gsap.set(visit, { x: event.clientX + 56, y: event.clientY + 36 });
          show(true);
        });
        row.addEventListener('pointermove', (event) => {
          xTo(event.clientX + 56);
          yTo(event.clientY + 36);
        });
        row.addEventListener('pointerleave', () => show(false));
      }
      addEventListener('scroll', () => show(false), { passive: true });
    }
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filters[hidden] {
    display: none;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .filter:hover {
    border-color: var(--ink);
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-ink);
  }

  .count {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .rows {
    position: relative;
    border-top: 1px solid var(--line);
  }

  .row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: center;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }

  /* Hover: a surface panel sweeps in from the left behind the row. */
  .row::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -0.5);
    z-index: -1;
    background: var(--surface);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .row:hover::before {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* Cursor-following pill (positioned by the script). */
  .visit {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 70;
    visibility: hidden;
    padding: 0.625rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.35);
  }

  .row[hidden] {
    display: none;
  }

  /* Make the whole row clickable when there is a link. */
  .row:has(.title-link) {
    cursor: pointer;
  }

  .title-link {
    text-decoration: none;
  }

  .title-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .row:hover .title-link {
    text-decoration: underline;
  }

  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
    transition: box-shadow 0.4s ease;
  }

  .row:hover .thumb {
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.25);
  }

  /* Screenshot wipes in from the left as the row is revealed. */
  :global(.can-reveal) .thumb {
    transition:
      clip-path 1s cubic-bezier(0.65, 0, 0.35, 1) 0.15s,
      box-shadow 0.4s ease;
  }

  :global(.can-reveal) .row:not(.is-in) .thumb {
    clip-path: inset(0 100% 0 0);
  }

  /* Tall screenshot (1:2.5): shows the top, scrolls through the page on hover.
     The box is 25% of the image's height, so -75% reaches the bottom. */
  .thumb img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .thumb img {
      transition: transform 1.2s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .row:hover .thumb img,
    .row:focus-within .thumb img {
      transform: translateY(-75%);
      transition-duration: 6s;
      transition-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    }
  }

  .thumb-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.4;
    background-image: linear-gradient(
      to top right,
      transparent calc(50% - 0.5px),
      var(--line) calc(50% - 0.5px),
      var(--line) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
  }

  .thumb-empty span {
    padding-inline: 0.375rem;
    background: var(--surface);
  }

  .body {
    display: grid;
    gap: 0.5rem;
    max-width: 40rem;
    /* Padding, not a transform: a transform would trap the row-wide link area inside .body. */
    transition: padding-left 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .row:hover .body {
    padding-left: 0.5rem;
  }

  .meta {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: var(--step-2);
  }

  .badge {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .badge--migration {
    border-color: var(--blue);
    background: color-mix(in srgb, var(--blue) 10%, transparent);
  }

  .badge--astro {
    border-color: var(--ink);
  }

  .summary {
    color: var(--muted);
  }

  .stack {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .domain {
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 47.99rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-block: 1.75rem;
    }
  }
</style>
