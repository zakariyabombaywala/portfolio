---
import SectionHeading from './SectionHeading.astro';
import SelectionBox from './SelectionBox.astro';
import { work, type ProjectCategory } from '../data/site';

const categories = Object.entries(work.categories) as [ProjectCategory, string][];
const countFor = (category: ProjectCategory) => work.projects.filter((p) => p.category === category).length;
const hostname = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="container">
    <SectionHeading id="work-title" title={work.title} intro={work.intro} />

    <div class="filters" role="group" aria-label="Filter projects" data-filters hidden>
      <button class="filter" type="button" aria-pressed="true" data-filter="all">
        {work.allLabel}<span class="count">{work.projects.length}</span>
      </button>
      {categories.map(([key, label]) => (
        <button class="filter" type="button" aria-pressed="false" data-filter={key}>
          {label}<span class="count">{countFor(key)}</span>
        </button>
      ))}
    </div>
    <p class="sr-only" role="status" data-filter-status></p>

    <ol class="rows">
      {work.projects.map((project) => (
        <li class="row selectable" data-category={project.category} data-animate>
          <div class="thumb">
            {project.image ? (
              <img
                src={project.image}
                alt={project.imageAlt ?? `Screenshot of ${project.title}`}
                width="1200"
                height="750"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="thumb-empty" aria-hidden="true">
                <span>Screenshot</span>
                <span>16:10</span>
              </span>
            )}
          </div>

          <div class="body">
            <p class="meta">
              {project.type}
              {project.year && `, ${project.year}`}
            </p>

            <h3 class="title">
              {project.url ? (
                <a class="title-link" href={project.url} target="_blank" rel="noopener">
                  {project.title}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                project.title
              )}
              <span class:list={['badge', `badge--${project.category}`]}>{work.categories[project.category]}</span>
            </h3>

            <p class="summary">{project.summary}</p>

            <p class="stack">
              <span class="sr-only">Built with: </span>
              {project.stack.join(', ')}
            </p>

            {project.url ? <p class="domain">{hostname(project.url)}</p> : <p class="domain">Live link coming soon</p>}
          </div>

          <SelectionBox mode="hover" inset="0.75rem calc(var(--gutter) * -0.5)" />
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.rows > li'));

  if (group) {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    group.hidden = false;

    const apply = (filter: string) => {
      const animate = document.documentElement.classList.contains('can-reveal');
      let shown = 0;

      for (const row of rows) {
        const visible = filter === 'all' || row.dataset.category === filter;
        row.hidden = !visible;
        if (!visible) continue;

        // Replay the rise-in so the list visibly reshuffles.
        if (animate && row.classList.contains('is-in')) {
          row.classList.remove('is-in');
          row.style.setProperty('--delay', `${shown * 70}ms`);
          requestAnimationFrame(() => requestAnimationFrame(() => row.classList.add('is-in')));
        }
        shown++;
      }

      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      }
      if (status) status.textContent = `Showing ${shown} ${shown === 1 ? 'project' : 'projects'}`;
    };

    buttons.forEach((button) => button.addEventListener('click', () => apply(button.dataset.filter ?? 'all')));
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filters[hidden] {
    display: none;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .filter:hover {
    border-color: var(--ink);
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-ink);
  }

  .count {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .rows {
    border-top: 1px solid var(--line);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: center;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .row[hidden] {
    display: none;
  }

  /* Make the whole row clickable when there is a link. */
  .row:has(.title-link) {
    cursor: pointer;
  }

  .title-link {
    text-decoration: none;
  }

  .title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row:hover .title-link {
    text-decoration: underline;
  }

  .thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
  }

  /* Screenshot wipes in from the left as the row is revealed. */
  :global(.can-reveal) .thumb {
    transition: clip-path 1s cubic-bezier(0.65, 0, 0.35, 1) 0.15s;
  }

  :global(.can-reveal) .row:not(.is-in) .thumb {
    clip-path: inset(0 100% 0 0);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    .thumb img {
      transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .row:hover .thumb img,
    .row:focus-within .thumb img {
      transform: scale(1.04);
    }
  }

  .thumb-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.4;
    background-image: linear-gradient(
      to top right,
      transparent calc(50% - 0.5px),
      var(--line) calc(50% - 0.5px),
      var(--line) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
  }

  .thumb-empty span {
    padding-inline: 0.375rem;
    background: var(--surface);
  }

  .body {
    display: grid;
    gap: 0.5rem;
    max-width: 40rem;
  }

  .meta {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: var(--step-2);
  }

  .badge {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .badge--migration {
    border-color: var(--blue);
    background: color-mix(in srgb, var(--blue) 10%, transparent);
  }

  .badge--astro {
    border-color: var(--ink);
  }

  .summary {
    color: var(--muted);
  }

  .stack {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .domain {
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 47.99rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-block: 1.75rem;
    }
  }
</style>
