---
import SectionHeading from './SectionHeading.astro';
import SelectionBox from './SelectionBox.astro';
import { work } from '../data/site';
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="container">
    <SectionHeading id="work-title" title={work.title} intro={work.intro} />

    <ol class="rows">
      {work.projects.map((project) => (
        <li class="row selectable">
          <div class="thumb">
            {project.image ? (
              <img
                src={project.image}
                alt={project.imageAlt ?? `Screenshot of ${project.title}`}
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="thumb-empty" aria-hidden="true">
                <span>Screenshot</span>
                <span>16:10</span>
              </span>
            )}
          </div>

          <div class="body">
            <p class="meta">{project.type}, {project.year}</p>

            <h3 class="title">
              {project.url ? (
                <a class="title-link" href={project.url} target="_blank" rel="noopener">
                  {project.title}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                project.title
              )}
              {project.placeholder && <span class="badge">Placeholder</span>}
            </h3>

            <p class="summary">{project.summary}</p>

            <p class="stack">
              <span class="sr-only">Built with: </span>
              {project.stack.join(', ')}
            </p>

            {!project.url && <p class="no-link">Live link coming soon</p>}
          </div>

          <SelectionBox mode="hover" inset="0.75rem calc(var(--gutter) * -0.5)" />
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .rows {
    border-top: 1px solid var(--line);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(12rem, 20rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: start;
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--line);
  }

  /* Make the whole row clickable when there is a link. */
  .row:has(.title-link) {
    cursor: pointer;
  }

  .title-link {
    text-decoration: none;
  }

  .title-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row:hover .title-link {
    text-decoration: underline;
  }

  .thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.4;
    background-image: linear-gradient(
      to top right,
      transparent calc(50% - 0.5px),
      var(--line) calc(50% - 0.5px),
      var(--line) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
  }

  .thumb-empty span {
    padding-inline: 0.375rem;
    background: var(--surface);
  }

  .body {
    display: grid;
    gap: 0.625rem;
    max-width: 40rem;
  }

  .meta {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: var(--step-2);
  }

  .badge {
    padding: 0.125rem 0.5rem;
    border: 1px dashed var(--pink);
    border-radius: 3px;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .summary {
    color: var(--muted);
  }

  .stack {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .no-link {
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 47.99rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-block: 1.75rem;
    }
  }
</style>
