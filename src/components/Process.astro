---
import SectionHeading from './SectionHeading.astro';
import { process } from '../data/site';
---

<section class="section process" id="process" aria-labelledby="process-title">
  <div class="container">
    <SectionHeading id="process-title" title={process.title} intro={process.intro} />

    <ol class="steps">
      {process.steps.map((step, i) => (
        <li class="step" data-animate>
          <p class="count">Step {i + 1}</p>
          <h3>{step.title}</h3>
          <p class="body">{step.body}</p>
          <ul class="outputs" aria-label={`What you get from ${step.title.toLowerCase()}`}>
            {step.outputs.map((output) => <li>{output}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.25rem clamp(1.25rem, 0.5rem + 2vw, 2.5rem) 0.5rem;
    border-left: 1px solid var(--line);
  }

  .step:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .step:last-child {
    padding-right: 0;
  }

  .count {
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  h3 {
    font-size: var(--step-2);
  }

  .body {
    color: var(--muted);
  }

  .outputs {
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .outputs li {
    padding-block: 0.5rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 55.99rem) {
    .steps {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .step,
    .step:first-child,
    .step:last-child {
      padding: 2.5rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  /* Hover: the step label becomes a blue pill, the title nudges over, and a
     selection handle pops in beside each deliverable, one after another. */
  .count {
    align-self: flex-start;
    margin-left: -0.5rem;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .step:hover .count {
    background: var(--blue);
    color: #16181d;
  }

  .step h3 {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .step:hover h3 {
    transform: translateX(0.25rem);
  }

  .outputs li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    transition: border-color 0.3s ease;
  }

  .outputs li::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--blue);
    background: var(--handle);
    transform: scale(0);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .step:hover .outputs li {
    border-color: color-mix(in srgb, var(--blue) 45%, var(--line));
  }

  .step:hover .outputs li::before {
    transform: scale(1);
  }

  .step:hover .outputs li:nth-child(2)::before { transition-delay: 0.06s; }
  .step:hover .outputs li:nth-child(3)::before { transition-delay: 0.12s; }
</style>
