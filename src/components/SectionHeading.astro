---
import SelectionBox from './SelectionBox.astro';

interface Props {
  id: string;
  title: string;
  intro?: string;
}

const { id, title, intro } = Astro.props;
---

<div class="heading" data-animate>
  <span class="title-frame" data-reveal>
    <h2 id={id}>{title}</h2>
    <SelectionBox mode="reveal" inset="-0.375rem -0.625rem" />
  </span>
  {intro && <p>{intro}</p>}
</div>

<script>
  // Select each heading once as it scrolls into view.
  const targets = document.querySelectorAll('[data-reveal]');

  if ('IntersectionObserver' in window && targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const target = entry.target;
          observer.unobserve(target);
          // Let the heading finish rising in before it gets selected.
          window.setTimeout(() => target.classList.add('is-revealed'), 450);
        }
      },
      { rootMargin: '0px 0px -20% 0px', threshold: 1 },
    );

    targets.forEach((target) => observer.observe(target));
  }
</script>

<style>
  .heading {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .title-frame {
    position: relative;
  }

  h2 {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  p {
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
