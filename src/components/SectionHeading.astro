---
interface Props {
  id: string;
  title: string;
  intro?: string;
}

const { id, title, intro } = Astro.props;
---

<div class="heading">
  <h2 id={id}>{title}</h2>
  {intro && <p>{intro}</p>}
</div>

<style>
  .heading {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  h2 {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  p {
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
