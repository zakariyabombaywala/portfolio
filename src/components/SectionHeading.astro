---
interface Props {
  id: string;
  title: string;
  intro?: string;
}

const { id, title, intro } = Astro.props;
---

<div class="heading">
  <h2 id={id} data-split>{title}</h2>
  {intro && <p data-animate>{intro}</p>}
</div>

<script>
  // Every [data-split] heading on the page (section headings and the contact
  // heading): words slide up through a mask as the heading scrolls into view.
  import { gsap, SplitText, prefersMotion } from '../scripts/motion';

  if (prefersMotion()) {
    document.fonts.ready.then(() => {
      gsap.utils.toArray<HTMLElement>('[data-split]').forEach((heading) => {
        SplitText.create(heading, {
          type: 'words',
          mask: 'words',
          autoSplit: true,
          onSplit: (self) => {
            // Room below each mask so descenders aren't clipped; the negative margin keeps the layout.
            gsap.set(self.masks, { paddingBottom: '0.16em', marginBottom: '-0.16em' });
            return gsap.from(self.words, {
              yPercent: 115,
              duration: 1.1,
              ease: 'expo.out',
              stagger: 0.07,
              scrollTrigger: { trigger: heading, start: 'top 88%', once: true },
            });
          },
        });
      });
    });
  }
</script>

<style>
  .heading {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  h2 {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  p {
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
